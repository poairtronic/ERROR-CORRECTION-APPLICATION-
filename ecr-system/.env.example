# Server Configuration
PORT=3000
NODE_ENV=production

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# Email Configuration (Gmail SMTP or Google Apps Script HTTPS proxy)
# Set EMAIL_PRIMARY_PROVIDER=smtp (500 emails/day) or gas (100 emails/day) with automatic fallback
EMAIL_PRIMARY_PROVIDER=smtp
# Create an App Password at https://myaccount.google.com/apppasswords
# Or set GMAIL_SCRIPT_URL to use the Google Apps Script Web App HTTPS proxy
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_TOKEN=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Scheduler Configuration
NOTIFICATION_RETRY_INTERVAL_MIN=1

# Frontend deep links
FRONTEND_URL=

# Internal Intake Secret
ECR_INTERNAL_SECRET=vsmart_ecr_bridge_2026_secure

# RM / V-Smart Integration
RM_FRONTEND_URL=
RM_API_URL=
RM_INTERNAL_SECRET=
